# Copy this to .env and fill in your values

# ── server/.env ──────────────────────────────────────────────────────────────
PORT=5000

# Set this to enable real model inference (FastAPI service)
ML_SERVICE_URL=http://localhost:8000

# PostgreSQL (optional — server runs with mock data without this)
DATABASE_URL=postgresql://postgres:password@localhost:5432/drought_platform
